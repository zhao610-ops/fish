# 在本地填写，不提交 config/runtime.env，不把密钥放进镜像。
# 自行设置一段足够长的后台访问密钥。
SERVER_API_KEY=

# 模型接口配置；模型与抓取服务可能收费。
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=

# 至少填写一个全文抓取服务。
JINA_API_KEY=
FIRECRAWL_API_KEY=

# 多个来源使用逗号分隔，也可直接在 TypeScript 配置里填写数组。
ARTICLE_SOURCES=

# 仅在准备真实发表时填写公众号凭证和自有封面。
WEIXIN_APP_ID=
WEIXIN_APP_SECRET=
WEIXIN_AUTHOR=公众号自动译刊
TRANSLATION_COVER_MEDIA_ID=
